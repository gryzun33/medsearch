
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) 
  email     String   @unique
  name      String 
  password  String
}

model Pharmacy {
  id        String  @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  hours     String
}
